# Copy this file to ".env" and fill in your values.

# Port the API runs on
PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/event-tracker

# From developer.ticketmaster.com -> My Apps -> "Consumer Key"
TICKETMASTER_API_KEY=your_consumer_key_here

# Where the React app runs (used for CORS and share-link redirects)
CLIENT_URL=http://localhost:5173

# Where this API runs (used to build share links)
SERVER_URL=http://localhost:5000

# Google Gemini key for the chat assistant (free): https://aistudio.google.com/apikey
# Leave empty to run the app without the chat.
GEMINI_API_KEY=your_gemini_key_here

# Which Gemini model to use. 'gemini-flash-latest' always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# City used when the user hasn't picked one.
# Ticketmaster mainly covers US, Canada, UK, Europe, Australia, NZ.
DEFAULT_CITY=New York
